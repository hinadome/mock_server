[Unit]
Description=Multi-protocol Mock Server
After=network.target

[Service]
Type=simple
User=mockserver
Group=mockserver
WorkingDirectory=/opt/mock-server
EnvironmentFile=-/opt/mock-server/.env.production
ExecStart=/usr/bin/node /opt/mock-server/dist/index.js
Restart=on-failure
RestartSec=5
# Bind app to localhost only — nginx is the public frontend
Environment=HOST=127.0.0.1
Environment=HOT_RELOAD=0
Environment=NODE_ENV=production

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/mock-server

[Install]
WantedBy=multi-user.target
