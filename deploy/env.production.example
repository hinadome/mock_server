# Production environment for mock-server (behind nginx)
# Copy to /opt/mock-server/.env.production and edit DOMAIN / secrets.

HOST=127.0.0.1
NODE_ENV=production
HOT_RELOAD=0
LOG_LEVEL=info

HTTP_PORT=3000
WS_PORT=3001
# Internal only — nginx publishes public :50051 / :1883|:8883 and must not share these
GRPC_PORT=15051
MQTT_PORT=11883

# Public URL clients should use (nginx TLS on 443)
PUBLIC_URL=https://DOMAIN_PLACEHOLDER
CORS_ORIGINS=https://DOMAIN_PLACEHOLDER

# App TLS off — nginx terminates TLS
TLS_ENABLED=0

# Optional JWT
# AUTH_REQUIRED=1
# JWT_ENABLED=1
# JWT_SECRET=change-me-to-a-long-random-string

MOCKS_DIR=./mocks
INSPECTOR_MAX=200
