# Container production env (nginx gateway terminates TLS)
# Copied to deploy/container/.env.production by deploy.sh if missing.

HOST=0.0.0.0
NODE_ENV=production
HOT_RELOAD=0
LOG_LEVEL=info

HTTP_PORT=3000
WS_PORT=3001
GRPC_PORT=50051
MQTT_PORT=1883

PUBLIC_URL=https://DOMAIN_PLACEHOLDER
CORS_ORIGINS=https://DOMAIN_PLACEHOLDER

TLS_ENABLED=0

# Optional JWT
# AUTH_REQUIRED=1
# JWT_ENABLED=1
# JWT_SECRET=change-me-to-a-long-random-string

MOCKS_DIR=./mocks
INSPECTOR_MAX=200
